{
  "name": "aerodesk",
  "version": "0.14.0",
  "description": "Windows desktop CFD viewer and OpenFOAM RANS case runner for air and submerged water",
  "author": "AeroDesk contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "build": "node build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && node package.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "45.0.0",
    "esbuild": "0.25.12",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "occt-import-js": "^0.0.23",
    "three": "0.186.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    }
  }
}
